  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Get a development token when there is none or it expires within a minute. The token request itself is skipped.",
          "const isTokenRequest = pm.request.url.getPath().endsWith('/auth/token');",
          "const expiresAt = Number(pm.collectionVariables.get('accessTokenExpiresAt') || 0);",
          "const hasFreshToken = pm.collectionVariables.get('accessToken') && expiresAt - Date.now() > 60000;",
          "if (!isTokenRequest && !hasFreshToken) {",
          "    pm.sendRequest({ url: pm.collectionVariables.get('baseUrl') + '/api/v1/auth/token', method: 'POST' }, (error, response) => {",
          "        // Outside Development the endpoint answers 404, so keep whatever token was pasted in.",
          "        if (error || response.code !== 200) return;",
          "        const body = response.json();",
          "        pm.collectionVariables.set('accessToken', body.accessToken);",
          "        pm.collectionVariables.set('accessTokenExpiresAt', String(Date.now() + body.expiresIn * 1000));",
          "    });",
          "}"
        ]
      }
    }
  ]
