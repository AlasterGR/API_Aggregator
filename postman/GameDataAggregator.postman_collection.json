{
  "info": {
    "_postman_id": "bc9471ae-c01f-4c4f-94b4-fc53fcd8d8d2",
    "name": "Game Data Aggregator",
    "description": "Requests for the Game Data Aggregator REST API.\n\nStart the API (`dotnet run --project src/GameDataAggregator.Api`), then run the requests one by one or with the Collection Runner. `baseUrl` defaults to the HTTP profile (http://localhost:5067). To use HTTPS (https://localhost:7252), trust the ASP.NET Core development certificate (`dotnet dev-certs https --trust`) or turn off SSL certificate verification in Postman's settings.\n\nAuthentication: the search and statistics endpoints need a JWT access token. While the API runs in Development, the collection's pre-request script gets one from `POST /api/v1/auth/token` and stores it in `accessToken`, so every request works without setup. Outside Development that endpoint does not exist: paste a token from your identity provider into the `accessToken` variable instead.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5067",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessTokenExpiresAt",
      "value": "0",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get development token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token"
              ]
            },
            "description": "Issues a short-lived JWT access token. Exists only while the API runs in Development, and answers 404 elsewhere. The test script stores the token in the `accessToken` collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns a bearer token\", () => {",
                  "    pm.expect(body.tokenType).to.eql(\"Bearer\");",
                  "    pm.expect(body.accessToken).to.be.a(\"string\").that.is.not.empty;",
                  "    pm.expect(body.expiresIn).to.be.above(0);",
                  "});",
                  "pm.collectionVariables.set(\"accessToken\", body.accessToken);",
                  "pm.collectionVariables.set(\"accessTokenExpiresAt\", String(Date.now() + body.expiresIn * 1000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search without a token (401)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/aggregation?search=witcher",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "aggregation"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "witcher"
                }
              ]
            },
            "description": "Shows that the search endpoint refuses requests without an access token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Asks for a bearer token\", () => pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.include(\"Bearer\"));",
                  "pm.test(\"Body is problem details\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Aggregation",
      "item": [
        {
          "name": "Search all sources",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/aggregation?search=witcher",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "aggregation"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "witcher"
                }
              ]
            },
            "description": "Queries every enabled source in parallel and returns one combined list. Each entry in `sources` says whether that source's data is Live, Cached, Fallback or Failed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response is JSON\", () => pm.response.to.be.json);",
                  "const body = pm.response.json();",
                  "pm.test(\"Has items and a status per source\", () => {",
                  "    pm.expect(body.items).to.be.an(\"array\");",
                  "    pm.expect(body.sources).to.be.an(\"array\").that.is.not.empty;",
                  "    body.sources.forEach(s => pm.expect([\"Live\", \"Cached\", \"Fallback\", \"Failed\", \"NotConfigured\"]).to.include(s.status));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Sources that need no key",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/aggregation?search=witcher&sources=CheapShark,Steam,Speedrun",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "aggregation"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "witcher"
                },
                {
                  "key": "sources",
                  "value": "CheapShark,Steam,Speedrun"
                }
              ]
            },
            "description": "CheapShark, Steam and speedrun.com need no API key, so this request returns live data on a fresh clone."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Exactly the three requested sources\", () => {",
                  "    pm.expect(body.sources.map(s => s.source)).to.eql([\"CheapShark\", \"Steam\", \"Speedrun\"]);",
                  "});",
                  "pm.test(\"None of them needs configuration\", () => {",
                  "    body.sources.forEach(s => pm.expect(s.status).to.not.eql(\"NotConfigured\"));",
                  "});",
                  "pm.test(\"Items come only from those sources\", () => {",
                  "    body.items.forEach(i => pm.expect([\"CheapShark\", \"Steam\", \"Speedrun\"]).to.include(i.source));",
                  "});"
                ]
              }
            }
          ]
        },
